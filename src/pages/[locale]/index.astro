---
import { getCollection } from 'astro:content';
import AboutSection from '../../components/AboutSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import FeaturedProjects from '../../components/FeaturedProjects.astro';
import Hero from '../../components/Hero.astro';
import SkillsCarousel from '../../components/SkillsCarousel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return ['fr', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale;

if (!locale || !isLocale(locale)) {
  return new Response(null, { status: 404 });
}

const copy: Record<Locale, {
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  projectsCta: string;
}> = {
  fr: {
    description: 'Portfolio de développement full-stack.',
    eyebrow: 'Portfolio full-stack',
    heading: 'Auguste ALEXANDRE',
    intro: 'Ingénieur logiciel diplômé d’EPITECH, je développe des applications web depuis 2020. Chez Orange Business, je participe à des projets full-stack, du développement à la mise en production.',
    projectsCta: 'Voir les projets',
  },
  en: {
    description: 'Full-stack development portfolio.',
    eyebrow: 'Full-stack portfolio',
    heading: 'Auguste ALEXANDRE',
    intro: 'An EPITECH-trained software engineer, I have built web applications since 2020. At Orange Business, I contribute to full-stack projects from development through production.',
    projectsCta: 'View projects',
  },
};

const content = copy[locale];
const projects = await getCollection('projects');
const featuredSlugs = ['teams-meeting-minutes', 'livecontrol', 'gargantua-onega'];
const featuredProjects = featuredSlugs.map((slug) => projects.find((project) => project.id === `${locale}/${slug}` && project.data.featured)).filter((project) => project !== undefined);
---

<BaseLayout locale={locale} title="Portfolio" description={content.description} surface="home">
  <Hero locale={locale} eyebrow={content.eyebrow} heading={content.heading} intro={content.intro} role={locale === 'fr' ? 'Développeur full-stack' : 'Full-stack Developer'} projectsLabel={content.projectsCta} />
  <AboutSection locale={locale} />
  <SkillsCarousel locale={locale} />
  <FeaturedProjects locale={locale} projects={featuredProjects} />
  <ContactSection locale={locale} />
</BaseLayout>
