---
import ProjectCard from '../../../components/ProjectCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects } from '../../../lib/projects';
import { isLocale, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return ['fr', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale;

if (!locale || !isLocale(locale)) {
  return new Response(null, { status: 404 });
}

const copy: Record<Locale, { description: string; intro: string; title: string }> = {
  fr: { title: 'Projets', description: 'Études de cas issues d expériences professionnelles et de projets personnels.', intro: 'Une sélection de réalisations, présentée dans le respect des contraintes de confidentialité.' },
  en: { title: 'Projects', description: 'Case studies from professional experience and personal projects.', intro: 'A selection of work presented with respect for confidentiality constraints.' },
};
const projects = await getProjects(locale);
---

<BaseLayout locale={locale} title={copy[locale].title} description={copy[locale].description} alternatePath="projects" surface="projects">
  <section class="page-content page-content--wide" aria-labelledby="page-title">
    <h1 id="page-title">{copy[locale].title}</h1>
    <p class="page-intro">{copy[locale].intro}</p>
    <div class="project-grid project-grid--listing">
      {projects.map((project) => <ProjectCard locale={locale} project={project} />)}
    </div>
  </section>
</BaseLayout>
