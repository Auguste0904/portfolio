---
import { render } from 'astro:content';
import ExternalProjectLinks from '../../../components/ExternalProjectLinks.astro';
import ProjectMeta from '../../../components/ProjectMeta.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProject, getProjectStaticPaths } from '../../../lib/projects';
import { isLocale, type Locale } from '../../../lib/i18n';

export { getProjectStaticPaths as getStaticPaths };

const locale = Astro.params.locale;
const slug = Astro.params.slug;

if (!locale || !isLocale(locale) || !slug) {
  return new Response(null, { status: 404 });
}

const project = await getProject(locale, slug);

if (!project) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(project);
const copy: Record<Locale, { contextRole: string; outcomes: string; problem: string; solution: string; technology: string }> = {
  fr: { problem: 'Problème', contextRole: 'Contexte et rôle', solution: 'Solution', technology: 'Technologies', outcomes: 'Résultats et apprentissages' },
  en: { problem: 'Problem', contextRole: 'Context and role', solution: 'Solution', technology: 'Technology', outcomes: 'Outcomes and learning' },
};
---

<BaseLayout locale={locale} title={project.data.title} description={project.data.summary} alternatePath={`projects/${project.data.slug}`}>
  <article class="project-case-study page-content">
    <p class="eyebrow">{locale === 'fr' ? 'Étude de cas' : 'Case study'}</p>
    <h1>{project.data.title}</h1>
    <p class="page-intro">{project.data.summary}</p>
    <ResponsiveImage image={project.data.image} alt={project.data.imageAlt} />
    <section data-project-section="problem">
      <h2>{copy[locale].problem}</h2>
      <p>{project.data.summary}</p>
    </section>
    <section data-project-section="context-role">
      <h2>{copy[locale].contextRole}</h2>
      <p>{project.data.context}</p>
      <p>{project.data.role}</p>
    </section>
    <section data-project-section="solution">
      <h2>{copy[locale].solution}</h2>
      <ul>{project.data.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
    </section>
    <div data-project-section="technology"><ProjectMeta label={copy[locale].technology} values={project.data.technologies} locale={locale} /></div>
    <section data-project-section="outcomes">
      <h2>{copy[locale].outcomes}</h2>
      <ul>{project.data.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
      <div class="prose"><Content /></div>
    </section>
    <ExternalProjectLinks locale={locale} github={project.data.github} demo={project.data.demo} />
  </article>
</BaseLayout>
