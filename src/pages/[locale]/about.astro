---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale } from '../../lib/i18n';

export function getStaticPaths() {
  return ['fr', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale;

if (!locale || !isLocale(locale)) {
  return new Response(null, { status: 404 });
}

const entry = await getEntry('pages', `${locale}/about`);

if (!entry) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} alternatePath="about">
  <article class="prose page-content">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
