---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { isLocale } from '../../lib/i18n';

export function getStaticPaths() {
  return ['fr', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale;

if (!locale || !isLocale(locale)) {
  return new Response(null, { status: 404 });
}

const copy = locale === 'fr'
  ? { title: 'Contact', description: 'Coordonnees directes du portfolio.', intro: 'Pour echanger sur un projet ou une opportunite, contactez-moi directement.' }
  : { title: 'Contact', description: 'Direct portfolio contact details.', intro: 'For a project or opportunity, please contact me directly.' };
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} alternatePath="contact">
  <section class="page-content" aria-labelledby="page-title">
    <h1 id="page-title">{copy.title}</h1>
    <p class="page-intro">{copy.intro}</p>
    <ContactLinks />
  </section>
</BaseLayout>
