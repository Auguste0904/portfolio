---
import { getLocalizedPath, type Locale } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={getLocalizedPath(locale)}>{site.name}</a>
    <MobileNavigation locale={locale} />
    <div class="site-header__actions"><LanguageSwitcher locale={locale} alternatePath={alternatePath} /><ThemeToggle locale={locale} /></div>
  </div>
</header>

<script>
  import '../scripts/mobile-navigation';
</script>
