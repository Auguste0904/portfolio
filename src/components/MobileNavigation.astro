---
import { getLocalizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const shellLabels = locale === 'fr'
  ? { openMenu: 'Ouvrir le menu', closeMenu: 'Fermer le menu', navigation: 'Navigation principale' }
  : { openMenu: 'Open menu', closeMenu: 'Close menu', navigation: 'Primary navigation' };
const labels = locale === 'fr'
  ? { presentation: 'Presentation', ai: 'IA', projects: 'Projets', journey: 'Parcours', contact: 'Contact' }
  : { presentation: 'Presentation', ai: 'AI', projects: 'Projects', journey: 'Journey', contact: 'Contact' };
const links = [
  ['presentation', labels.presentation],
  ['ai', labels.ai],
  ['projects', labels.projects],
  ['journey', labels.journey],
  ['contact', labels.contact],
] as const;
---

<button
  class="menu-toggle"
  type="button"
  aria-controls="primary-navigation"
  aria-expanded="false"
  data-menu-toggle
  data-open-label={shellLabels.openMenu}
  data-close-label={shellLabels.closeMenu}
>
  <span data-menu-label>{shellLabels.openMenu}</span>
</button>
<nav class="site-nav" id="primary-navigation" aria-label={shellLabels.navigation} data-mobile-navigation>
  <ul>
    {links.map(([anchor, label]) => <li><a href={`${getLocalizedPath(locale)}#${anchor}`}>{label}</a></li>)}
  </ul>
</nav>
