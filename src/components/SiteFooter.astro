---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'fr'
  ? { message: 'Portfolio de demonstration', accessibility: 'Statique et accessible' }
  : { message: 'Portfolio demonstration', accessibility: 'Static and accessible' };
---

<footer class="site-footer">
  <span>{copy.message}</span>
  <span>{copy.accessibility}</span>
</footer>
