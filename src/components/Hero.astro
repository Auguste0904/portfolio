---
interface Props {
  locale: import('../lib/i18n').Locale;
  eyebrow: string;
  heading: string;
  intro: string;
  role: string;
  projectsLabel: string;
}

import { getCvPath, cvFilename } from '../lib/cv';
import { site } from '../lib/site';
const { locale, eyebrow, heading, intro, role, projectsLabel } = Astro.props;
const fr = locale === 'fr';
const [firstName, ...lastName] = heading.split(' ');
---

<section id="intro" class="hero home-section" aria-labelledby="page-title">
  <div class="hero__content">
    <p class="eyebrow">01 / 05 · {eyebrow}</p>
    <p class="hero__greeting">{fr ? 'Bonjour, je suis' : 'Hello, I’m'}</p>
    <h1 id="page-title"><span>{firstName}</span><span>{lastName.join(' ')}</span></h1>
    <p class="hero__role">{role}</p>
    <p class="hero__intro">{intro}</p>
    <div class="hero__actions">
      <a class="button-link" href="#projects">{projectsLabel} <span aria-hidden="true">↗</span></a>
      <a class="button-link button-link--outline" href={getCvPath(import.meta.env.BASE_URL)} download={cvFilename}>{fr ? 'Télécharger mon CV' : 'Download my résumé'} <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero__socials"><span>{fr ? 'ME RETROUVER' : 'FIND ME'}</span><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
  </div>
  <div class="hero-art" aria-hidden="true"><div class="hero-art__top"><span>AA / {fr ? 'NOTES DE TERRAIN' : 'FIELD NOTES'}</span><span>{locale.toUpperCase()}</span></div><div class="hero-art__center"><span>{fr ? 'CONSTRUIRE / 01' : 'BUILD / 01'}</span><strong>{fr ? <>Imaginer.<br />Créer.<br /><em>Faire évoluer.</em></> : <>Imagine.<br />Build.<br /><em>Evolve.</em></>}</strong></div><div class="hero-art__bottom"><span>{fr ? 'CONCEVOIR → DÉVELOPPER → DÉPLOYER' : 'DESIGN → DEVELOP → DEPLOY'}</span><span>↗</span></div></div>
</section>
