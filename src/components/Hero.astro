---
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
}

const { eyebrow, heading, intro } = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="page-title">{heading}</h1>
  <p class="hero__intro">{intro}</p>
</section>
