---
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  role: string;
  projectsLabel: string;
  contactLabel: string;
}

const { eyebrow, heading, intro, role, projectsLabel, contactLabel } = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="page-title">{heading}</h1>
  <p class="hero__role">{role}</p>
  <p class="hero__intro">{intro}</p>
  <div class="hero__actions">
    <a class="button-link" href="#projects">{projectsLabel}</a>
    <a class="text-link" href="#contact">{contactLabel}</a>
  </div>
</section>
