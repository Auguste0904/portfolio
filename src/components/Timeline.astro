---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const formatter = new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric' });
const presentLabel = locale === 'fr' ? 'Aujourd’hui' : 'Present';
---

<ol class="timeline">
  {entries.map((entry) => (
    <li>
      <p class="timeline__dates">
        <time datetime={entry.data.startDate.toISOString()}>{formatter.format(entry.data.startDate)}</time>
        {' - '}
        {entry.data.endDate ? <time datetime={entry.data.endDate.toISOString()}>{formatter.format(entry.data.endDate)}</time> : presentLabel}
      </p>
      <h2>{entry.data.title}</h2>
      <p>{entry.data.summary}</p>
    </li>
  ))}
</ol>
