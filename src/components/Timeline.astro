---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'experience'>[];
}

const { entries } = Astro.props;
const formatter = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });
---

<ol class="timeline">
  {entries.map((entry) => (
    <li>
      <p class="timeline__dates">
        <time datetime={entry.data.startDate.toISOString()}>{formatter.format(entry.data.startDate)}</time>
        {' - '}
        {entry.data.endDate ? <time datetime={entry.data.endDate.toISOString()}>{formatter.format(entry.data.endDate)}</time> : 'Present'}
      </p>
      <h3>{entry.data.title}</h3>
      <p>{entry.data.summary}</p>
    </li>
  ))}
</ol>
