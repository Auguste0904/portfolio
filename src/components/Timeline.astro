---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { normalizePublicImagePath } from '../lib/images';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const formatter = new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric' });
const presentLabel = locale === 'fr' ? 'Aujourd’hui' : 'Present';
---

<ol class="timeline">
  {entries.map((entry) => (
    <li>
      <p class="timeline__dates">
        <time datetime={entry.data.startDate.toISOString()}>{formatter.format(entry.data.startDate)}</time>
        {' - '}
        {entry.data.endDate ? <time datetime={entry.data.endDate.toISOString()}>{entry.data.endYearOnly ? entry.data.endDate.getFullYear() : formatter.format(entry.data.endDate)}</time> : presentLabel}
      </p>
      <div class="timeline__heading">
        {entry.data.logo && <img class="timeline__logo" src={normalizePublicImagePath(entry.data.logo, import.meta.env.BASE_URL)} alt={entry.data.logoAlt ?? entry.data.title} loading="lazy" />}
        <h2>{entry.data.title}</h2>
      </div>
      <p>{entry.data.summary}</p>
      {entry.data.highlights.length > 0 && <ul class="timeline__highlights">{entry.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
    </li>
  ))}
</ol>
