---
import type { CollectionEntry } from 'astro:content';
import { getLocalizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
}

const { locale, project } = Astro.props;
const detailPath = getLocalizedPath(locale, `projects/${project.data.slug}`);
---

<article class="project-card">
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p>
  <ul aria-label="Technologies">
    {project.data.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <a href={detailPath}>{locale === 'fr' ? 'Lire l etude de cas' : 'Read case study'}</a>
</article>
