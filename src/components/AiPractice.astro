---
import TechnologyBadge from './TechnologyBadge.astro';
import type { Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = locale === 'fr' ? {
  practice: 'Pratique du developpement assiste par IA', models: 'Familiarite avec les modeles', experience: 'Experience produit confirmee',
  practiceText: 'OpenCode, les plugins oh-my-openagent, ses agents, ses skills et les integrations MCP accompagnent l exploration du code, la structuration du travail, la consultation de documentation et la verification. Le jugement d ingenierie reste au centre des revues.',
  modelsText: 'Claude Sonnet, GPT-5.6 Terra, Qwen 3.6 et Qwen 3.8, avec une connaissance des ecosystemes proprietaires et open source.',
  experienceText: 'Chez Orange Business, experience sur une application Microsoft Teams de generation de comptes rendus de reunion avec Orange Live Intelligence. Les details de mise en oeuvre et les informations produit confidentielles ne sont pas publies.',
} : {
  practice: 'AI-assisted development practice', models: 'Model familiarity', experience: 'Confirmed product experience',
  practiceText: 'OpenCode, oh-my-openagent plugins, agents, skills and MCP integrations support codebase exploration, implementation planning, documentation consultation and verification. Engineering review remains central.',
  modelsText: 'Claude Sonnet, GPT-5.6 Terra, Qwen 3.6 and Qwen 3.8, with awareness of proprietary and open-source model ecosystems.',
  experienceText: 'At Orange Business, experience on a Microsoft Teams meeting-minutes application using Orange Live Intelligence. Implementation details and confidential product information are not published.',
};
---
<div class="ai-practice">
  <section><h3>{copy.practice}</h3><p>{copy.practiceText}</p><div class="technology-list">{['opencode', 'context7', 'playwright'].map((technology) => <TechnologyBadge technology={technology} locale={locale} />)}</div></section>
  <section><h3>{copy.models}</h3><p>{copy.modelsText}</p></section>
  <section><h3>{copy.experience}</h3><p>{copy.experienceText}</p></section>
</div>
